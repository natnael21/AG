# Copy to .env (gitignored) and fill in. Nothing here belongs in Git.

# Port on 127.0.0.1 the vault is published to.
VAULTWARDEN_PORT=8222
DOMAIN=https://localhost:8222

# Registration is CLOSED by default, so a fresh install cannot create its first
# account until you open it. Set true, `docker compose up -d`, register, then set
# false and `docker compose up -d` again.
SIGNUPS_ALLOWED=false

# Optional: restrict which email domains may register while signups are open.
SIGNUPS_DOMAINS_WHITELIST=

# Optional and off by default. If you enable /admin, generate an argon2 hash --
# never a plaintext token:
#   docker run --rm -it vaultwarden/server:1.36.0-alpine /vaultwarden hash
ADMIN_TOKEN=
