PORT=3000
NODE_ENV=development
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
# TLS to the database. RDS requires it (default). Set to 0 for a local or CI
# postgres, which normally has none.
# DB_SSL=1
# Comma-separated browser origins allowed for CORS (omit to use defaults incl. preprod)
# CORS_ORIGINS=https://agshopro.com,https://www.agshopro.com,https://preprod.agshopro.com,http://localhost:3000
RESET_BASE_URL=https://agshopro.com
# Set to 1 in CI or local API-only checks to skip DB ping on /api/health
# HEALTH_SKIP_DB=0
# Set to 1 to skip the SMTP check on /api/health
# HEALTH_SKIP_SMTP=0

# Integration tests (npm run test:integration). TEST_DB_NAME is DROPPED and
# recreated on every run — never point it at a database you care about.
# See api/test/README.md.
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5432
# TEST_DB_USER=postgres
# TEST_DB_PASS=postgres
# TEST_DB_NAME=agshop_test
# TEST_DB_SSL=0

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
FROM_EMAIL=noreply@agshopro.com
SUPPORT_EMAIL=support@agshopro.com
APP_URL=https://agshopro.com
